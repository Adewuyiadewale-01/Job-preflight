# ---- Application Mail Preflight — environment template ----
# Server-side only. Never commit the real .env, and never ship these
# values into a browser bundle.

# Zoho Mail SMTP (used to send preflight packages to seed inboxes)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=you@yourdomain.dev
ZOHO_SMTP_PASSWORD=
MAIL_FROM="Jane Doe <you@yourdomain.dev>"

# Strict comma-separated allowlist of seed inbox addresses.
# The send endpoint rejects every recipient not listed here.
TEST_RECIPIENT_ALLOWLIST=seed1@gmail.com,seed2@outlook.com,seed3@yahoo.com,seed4@yourdomain.dev

# SQLite via Prisma
DATABASE_URL=file:./dev.db

# 32-byte key used to encrypt OAuth tokens at rest (AES-256-GCM)
APP_ENCRYPTION_KEY=

# Seed mailbox OAuth applications
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
