# ---- Application Mail Preflight — environment template ----
# Server-side only. Never commit the real .env, and never ship these
# values into a browser bundle. Every variable has a safe DUMMY default in
# server/src/config.ts, so the project builds and tests with this file empty.

# --- Local backend ---
PORT=3100
DATA_DIR=./data
PUBLIC_ORIGIN=http://localhost:3100
# Set MOCK_PROVIDERS=1 to exercise the full pipeline with simulated provider
# responses (development + automated tests). Mock output is always labelled.
MOCK_PROVIDERS=

# --- Zoho Mail SMTP (live preflight sends to seed inboxes only) ---
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=you@yourdomain.dev
ZOHO_SMTP_PASSWORD=
MAIL_FROM="Jane Doe <you@yourdomain.dev>"

# --- Strict comma-separated allowlist of seed inbox addresses ---
# The send endpoint rejects every recipient not listed here — including any
# employer address, before the SMTP conversation starts.
TEST_RECIPIENT_ALLOWLIST=seed1@gmail.com,seed2@outlook.com,seed3@yahoo.com,seed4@yourdomain.dev

# --- Storage & secrets ---
DATABASE_URL=file:./data/dev.db
# ≥32 characters — used for AES-256-GCM encryption of OAuth tokens at rest
APP_ENCRYPTION_KEY=

# --- Seed mailbox OAuth applications ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# --- Polling behaviour ---
SEED_WAIT_TIMEOUT_SEC=45
POLL_INTERVAL_SEC=3
